<Window x:Class="zPlayer.App.MainWindow"
        Icon="/Assets/Icons/zPlayer.ico"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:art="clr-namespace:zPlayer.App.Artwork"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:zPlayer.App"
        xmlns:converters="clr-namespace:zPlayer.App.Converters"
        mc:Ignorable="d"
        Title="zPlayer" Height="720" Width="1280"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterScreen">
    <Window.Background>
        <SolidColorBrush Color="{StaticResource BackgroundColor}"/>
    </Window.Background>
    <Window.Resources>

        <Style TargetType="Label" x:Key="MiniTitle">
            <Setter Property="Foreground" Value="{StaticResource TextBrush}"/>
            <Setter Property="Opacity" Value="0.5"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Margin" Value="6,6,0,0"/>
        </Style>
        <Style TargetType="TextBlock" x:Key="ItemLabel">
            <Setter Property="Foreground" Value="{StaticResource TextBrush}"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Width" Value="150"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>
        <Style TargetType="Image" x:Key="ItemIcon">
            <Setter Property="Width" Value="16"/>
            <Setter Property="Height" Value="16"/>
            <Setter Property="Margin" Value="8,0,6,0"/>
        </Style>
        <Style TargetType="TextBlock" x:Key="SongTitle">
            <Setter Property="Foreground" Value="{StaticResource TextBrush}"/>
            <Setter Property="FontSize" Value="15"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="TextTrimming" Value="CharacterEllipsis"/>
            <Setter Property="Margin" Value="16,4"/>
            <Setter Property="HorizontalAlignment" Value="Center"/>
            <Setter Property="VerticalAlignment" Value="Top"/>
        </Style>
        <Style TargetType="TextBlock" x:Key="ArtistTitle">
            <Setter Property="Foreground" Value="{StaticResource TextBrush}"/>
            <Setter Property="FontSize" Value="10"/>
            <Setter Property="FontStyle" Value="Italic"/>
            <Setter Property="Opacity" Value="0.5"/>
            <Setter Property="TextTrimming" Value="CharacterEllipsis"/>
            <Setter Property="Margin" Value="16,4"/>
            <Setter Property="HorizontalAlignment" Value="Center"/>
            <Setter Property="VerticalAlignment" Value="Bottom"/>
        </Style>
        <Style TargetType="TextBlock" x:Key="Timestamp">
            <Setter Property="Foreground" Value="{StaticResource TextBrush}"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="VerticalAlignment" Value="Bottom"/>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition x:Name="PlaybackBarRow" Height="0"/> <!--Only shows up when there's a song in the queue-->
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="150"/>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="24"/>
            <ColumnDefinition x:Name="QueueColumn" Width="0"/> <!--Toggled with a button-->
        </Grid.ColumnDefinitions>

        <!--Tabs sidebar-->
        <Border Grid.RowSpan="2" Grid.Column="0" Style="{StaticResource PanelLeft}">
            <StackPanel>
                <!--Library-->
                <Label Content="Library" Style="{StaticResource MiniTitle}"/>
                <ListBox x:Name="LibraryNavigation" ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                             BorderThickness="0" Background="Transparent"
                             ItemContainerStyle="{StaticResource SidebarItem}"
                             SelectionChanged="LibraryNavigation_SelectionChanged"
                             SelectedIndex="0">
                    <ListBoxItem Tag="Songs">
                        <StackPanel Orientation="Horizontal">
                            <Image Source="/Assets/Icons/Song_32x.png" Style="{StaticResource ItemIcon}"/>
                            <TextBlock Text="Songs" Style="{StaticResource ItemLabel}"/>
                        </StackPanel>
                    </ListBoxItem> <!--
                    <ListBoxItem Tag="Artists">
                        <StackPanel Orientation="Horizontal">
                            <Image Source="/Assets/Icons/Artist_32x.png" Style="{StaticResource ItemIcon}"/>
                            <TextBlock Text="Artists" Style="{StaticResource ItemLabel}"/>
                        </StackPanel>
                    </ListBoxItem> -->
                    <ListBoxItem Tag="Albums">
                        <StackPanel Orientation="Horizontal">
                            <Image Source="/Assets/Icons/Album_32x.png" Style="{StaticResource ItemIcon}"/>
                            <TextBlock Text="Albums" Style="{StaticResource ItemLabel}"/>
                        </StackPanel>
                    </ListBoxItem>
                    <ListBoxItem Tag="Mixes">
                        <StackPanel Orientation="Horizontal">
                            <Image Source="/Assets/Icons/Mix_32x.png" Style="{StaticResource ItemIcon}"/>
                            <TextBlock Text="Mixes" Style="{StaticResource ItemLabel}"/>
                        </StackPanel>
                    </ListBoxItem>
                </ListBox>
                <!--Application-->
                <Label Content="Application" Style="{StaticResource MiniTitle}"/>
                <ListBox x:Name="AppNavigation" ScrollViewer.HorizontalScrollBarVisibility="Disabled"
             BorderThickness="0" Background="Transparent"
             ItemContainerStyle="{StaticResource SidebarItem}"
             SelectionChanged="AppNavigation_SelectionChanged">
                    <ListBoxItem Tag="Settings">
                        <StackPanel Orientation="Horizontal">
                            <Image Source="/Assets/Icons/Cog_32x.png" Style="{StaticResource ItemIcon}"/>
                            <TextBlock Text="Settings" Style="{StaticResource ItemLabel}"/>
                        </StackPanel>
                    </ListBoxItem>
                </ListBox>
            </StackPanel>
        </Border>

        <!--Playback queue sidebar-->
        <Border Grid.Column="2" Style="{StaticResource PanelRight}">
            <StackPanel Orientation="Vertical" Margin="2,6">
                <Button Click="ToggleQueue_Click" Style="{StaticResource IconButton}" Opacity="0.5" Margin="0,0,0,24">
                    <Image Source="/Assets/Icons/Queue_32x.png"/>
                </Button>
                <Button Click="ClearQueue_Click" Style="{StaticResource IconButton}" Opacity="0.5">
                    <Image Source="/Assets/Icons/QueueClear_32x.png"/>
                </Button>
            </StackPanel>
        </Border>
        <Border Grid.Column="3" Grid.RowSpan="2" Style="{StaticResource PanelRight}">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="24"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <TextBlock Text="Playback Queue" Style="{StaticResource WindowTitle}" Grid.Row="0" HorizontalAlignment="Center"/>

                <ListBox x:Name="QueueList" Grid.Row="1" ItemContainerStyle="{StaticResource PlaybackQueueItem}"
                        Background="Transparent" BorderThickness="0"
                        Focusable="False" SelectionMode="Single"
                         SelectionChanged="QueueList_SelectionChanged"
                         ScrollViewer.CanContentScroll="True" VirtualizingPanel.ScrollUnit="Pixel"
                         VirtualizingPanel.VirtualizationMode="Recycling"
                         ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="32"/>
                                </Grid.ColumnDefinitions>

                                <Button Grid.Column="0" Click="QueueSong_Click"
                                            Style="{StaticResource ListRowButton}"
                                            HorizontalContentAlignment="Stretch"
                                            Focusable="False" ToolTip="Jump to song">
                                    <Grid Margin="4">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="44"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>

                                        <Border Width="40" Height="40" CornerRadius="3" ClipToBounds="True" art:CoverArt.Small="True" art:CoverArt.Reference="{Binding Cover}" art:CoverArt.Enabled="True">
                                        </Border>

                                        <StackPanel Grid.Column="1" Margin="4,0,4,0" VerticalAlignment="Center">
                                            <TextBlock Text="{Binding Title}" FontSize="13" FontWeight="SemiBold"
                                                       Foreground="{DynamicResource TextBrush}"
                                                       TextTrimming="CharacterEllipsis"/>
                                            <TextBlock Text="{Binding Artist}" FontSize="11" Opacity="0.5"
                                                       Foreground="{DynamicResource TextBrush}"
                                                       TextTrimming="CharacterEllipsis"/>
                                        </StackPanel>
                                    </Grid>
                                </Button>

                                <Button Grid.Column="1" Click="RemoveQueueSong_Click"
                                        Style="{StaticResource IconButton}" Opacity="0.5"
                                        Width="20" Height="20" VerticalAlignment="Center"
                                        Focusable="False" ToolTip="Remove from queue">
                                    <Image Source="/Assets/Icons/Remove_32x.png" Margin="4"/>
                                </Button>
                            </Grid>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </Grid>
        </Border>

        <!--Main Content-->
        <ContentControl x:Name="MainContent" Grid.Row="0" Grid.Column="1"/>

        <!--Playback bar-->
        <Border Grid.Row="1" Grid.ColumnSpan="3" Style="{StaticResource PanelBottom}">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="1*"/>
                    <RowDefinition Height="0.8*"/>
                    <RowDefinition Height="22"/>
                </Grid.RowDefinitions>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="100"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <Border BorderThickness="0,2,2,0" BorderBrush="{StaticResource BorderBrush}"
            Grid.RowSpan="3" Grid.Column="0" Margin="0,-2,-2,0">
                    <Image x:Name="CurrentSongArtwork" art:CoverArt.Enabled="True" Stretch="Fill"/>
                </Border>
                <!--Loop, Shuffle, and Title/Artist-->
                <Grid Grid.Row="0" Grid.Column="1">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="52"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="52"/>
                    </Grid.ColumnDefinitions>
                    <Button Click="LoopButton_Click" Style="{StaticResource IconButton}"
                            HorizontalAlignment="Left" VerticalAlignment="Top"
                            Width="32" Margin="10" Grid.Column="0">
                        <Image x:Name="LoopButtonImage" Style="{StaticResource LoopIcon}"/>
                    </Button>

                    <TextBlock x:Name="SongTitleText" Text="Very Long Song Title For Testing Long Names"
                            Grid.Column="1" Style="{StaticResource SongTitle}"/>
                    <TextBlock x:Name="SongArtistText" Text="Very Long Artist Name — Very Long Album Name"
                            Grid.Column="1" Style="{StaticResource ArtistTitle}"/>

                    <Button x:Name="ShuffleButton" Click="ShuffleButton_Click" Style="{StaticResource IconButton}"
                            HorizontalAlignment="Right" VerticalAlignment="Top"
                            Width="32" Margin="10" Grid.Column="2">
                        <Image Source="/Assets/Icons/Shuffle_32x.png"/>
                    </Button>
                </Grid>
                <!--Volume and Skip/Play/Loop-->
                <Grid Grid.Row="1" Grid.Column="1" Margin="0,6">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="52"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="86"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="52"/>
                    </Grid.ColumnDefinitions>
                    <Button x:Name="VolumeButton" Style="{StaticResource IconButton}"
                            MouseEnter="Volume_MouseEnter" MouseLeave="Volume_MouseLeave"
                            Grid.Column="0" Width="32" Margin="10,0"
                            HorizontalAlignment="Left" VerticalAlignment="Center">
                        <Image Source="/Assets/Icons/Speaker_32x.png"/>
                    </Button>
                    <Popup x:Name="VolumePopup"
                           PlacementTarget="{Binding ElementName=VolumeButton}" Placement="Right"
                           MouseEnter="Volume_MouseEnter" MouseLeave="Volume_MouseLeave"
                           HorizontalOffset="12" StaysOpen="True" AllowsTransparency="True">
                        <Border Background="{StaticResource SurfaceBrush}">
                            <Slider x:Name="VolumeSlider" Style="{StaticResource FilledSlider}" Width="320" Height="24"
                                    VerticalAlignment="Center" Opacity="0"
                                    Minimum="0" Maximum="1" Value="0.5"
                                    SmallChange="0.01" LargeChange="0.1"/>
                        </Border>
                    </Popup>

                    <Button Click="BackButton_Click" Style="{StaticResource IconButton}"
                Width="32" Grid.Column="2" Margin="0,3" HorizontalAlignment="Left">
                        <Image Source="/Assets/Icons/Back_32x.png"/>
                    </Button>
                    <Button Click="PlayPauseButton_Click" Style="{StaticResource IconButton}"
                Width="32" Grid.Column="2" Margin="0,-2">
                        <Image x:Name="PlayPauseImage" Source="/Assets/Icons/Play_32x.png"/>
                    </Button>
                    <Button Click="SkipButton_Click" Style="{StaticResource IconButton}"
                Width="32" Grid.Column="2" Margin="0,3" HorizontalAlignment="Right">
                        <Image Source="/Assets/Icons/Skip_32x.png"/>
                    </Button>
                </Grid>
                <!--Timeline-->
                <Grid Grid.Row="2" Grid.Column="1" Margin="8,0,8,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="42"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="42"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" x:Name="CurTime" Text="00:00"
                            HorizontalAlignment="Right" Margin="0,0,6,0" Style="{StaticResource Timestamp}"/>
                    <Slider x:Name="TimelineSlider" Grid.Column="1" Style="{StaticResource Timeline}"
                            Minimum="0" Maximum="1" Value="0" IsEnabled="False"
                            SmallChange="1" LargeChange="5" IsMoveToPointEnabled="True"/>
                    <TextBlock Grid.Column="2" x:Name="TotalTime" Text="00:00"
                            HorizontalAlignment="Left" Margin="6,0,0,0" Style="{StaticResource Timestamp}"/>
                </Grid>
            </Grid>
        </Border>
        
        <!--Popup menus overlay-->
        <Grid x:Name="PopupOverlay" Grid.RowSpan="2" Grid.ColumnSpan="4"
              Panel.ZIndex="100" Background="Transparent" Visibility="Collapsed" Opacity="0">
            <Border Background="Black" MouseLeftButtonDown="PopupOverlay_Click" Opacity="0.5"/>
            <Border x:Name="PopupContainer" HorizontalAlignment="Center" VerticalAlignment="Center"
                    Background="{StaticResource BackgroundBrush}" BorderBrush="{StaticResource BorderBrush}"
                    BorderThickness="2" CornerRadius="3" Padding="4" MaxWidth="600" MaxHeight="700">
                <ContentControl x:Name="PopupContent"/>
            </Border>
        </Grid>
    </Grid>
</Window>
