<ResourceDictionary
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Color x:Key="BackgroundColor">#1C1D29</Color>
    <Color x:Key="SurfaceColor">#232431</Color>
    <Color x:Key="BorderColor">#2B2C3B</Color>
    <Color x:Key="HighlightColor">#3B3C4C</Color>
    <Color x:Key="SelectedColor">#2680D9</Color>
    <Color x:Key="SelectedColorSecondary">#27c0d9</Color>
    <Color x:Key="TextColor">#F2F2F2</Color>

    <SolidColorBrush x:Key="BackgroundBrush" Color="{DynamicResource BackgroundColor}"/>
    <SolidColorBrush x:Key="SurfaceBrush" Color="{DynamicResource SurfaceColor}"/>
    <SolidColorBrush x:Key="BorderBrush" Color="{DynamicResource BorderColor}"/>
    <SolidColorBrush x:Key="HighlightBrush" Color="{DynamicResource HighlightColor}"/>
    <SolidColorBrush x:Key="SelectedBrush" Color="{DynamicResource SelectedColor}"/>
    <SolidColorBrush x:Key="SelectedBrushSecondary" Color="{DynamicResource SelectedColorSecondary}"/>
    <SolidColorBrush x:Key="TextBrush" Color="{DynamicResource TextColor}"/>
</ResourceDictionary>