<ResourceDictionary
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:converters="clr-namespace:zPlayer.App.Converters">
    <converters:FillWidthConverter x:Key="FillWidthConverter"/>

    <Style TargetType="Thumb" x:Key="SliderThumb">
        <Setter Property="Width" Value="16"/>
        <Setter Property="Height" Value="16"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Thumb">
                    <Ellipse Fill="{DynamicResource TextBrush}" StrokeThickness="0"/>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style BasedOn="{StaticResource SliderThumb}" TargetType="Thumb" x:Key="SliderThumbTimeline">
        <Setter Property="Width" Value="3"/>
        <Setter Property="Height" Value="14"/>
        <Setter Property="Margin" Value="4,0,-10,0"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Thumb">
                    <Border Background="{DynamicResource TextBrush}" Margin="0,2,0,-6" VerticalAlignment="Stretch"
                        BorderThickness="0" CornerRadius="1.5,1.5,0,0"/>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style TargetType="RepeatButton" x:Key="SliderTrack">
        <Setter Property="Focusable" Value="False"/>
        <Setter Property="IsTabStop" Value="False"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="RepeatButton">
                    <Border Background="Transparent"/>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style BasedOn="{StaticResource SliderTrack}" TargetType="RepeatButton" x:Key="SliderFill">
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="RepeatButton">
                    <Border Background="{DynamicResource SelectedBrush}" CornerRadius="3" Margin="0,0,-8,0"/>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style TargetType="Slider" x:Key="FilledSlider">
        <Setter Property="Height" Value="34"/>
        <Setter Property="IsMoveToPointEnabled" Value="True"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Slider">
                    <Grid>
                        <Border Height="6" CornerRadius="3" VerticalAlignment="Center"
                            Background="{DynamicResource BackgroundBrush}"/>
                        <Track x:Name="PART_Track" VerticalAlignment="Center"
                           Height="16" Minimum="{TemplateBinding Minimum}" Maximum="{TemplateBinding Maximum}"
                           Value="{Binding Value, RelativeSource={RelativeSource TemplatedParent}, Mode=TwoWay}"
                           Orientation="Horizontal">
                            <Track.DecreaseRepeatButton>
                                <RepeatButton Style="{StaticResource SliderFill}" Height="6"/>
                            </Track.DecreaseRepeatButton>

                            <Track.Thumb>
                                <Thumb Style="{StaticResource SliderThumb}"/>
                            </Track.Thumb>

                            <Track.IncreaseRepeatButton>
                                <RepeatButton Style="{StaticResource SliderTrack}"/>
                            </Track.IncreaseRepeatButton>
                        </Track>
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style TargetType="Slider" x:Key="Timeline">
        <Setter Property="VerticalAlignment" Value="Bottom"/>
        <Setter Property="IsMoveToPointEnabled" Value="True"/>

        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Slider">
                    <Grid>
                        <Grid x:Name="TrackVisual" Height="14" Margin="0,4,0,0"
                          VerticalAlignment="Center" ClipToBounds="True">
                            <Border Background="{DynamicResource BackgroundBrush}" CornerRadius="3,0,0,0"/>
                            <Border CornerRadius="3,0,0,0" HorizontalAlignment="Left">
                                <Border.Background>
                                    <LinearGradientBrush StartPoint="0,0.5" EndPoint="1,0.5">
                                        <GradientStop Color="{DynamicResource SelectedColor}" Offset="0"/>
                                        <GradientStop Color="{DynamicResource SelectedColorSecondary}" Offset="1"/>
                                    </LinearGradientBrush>
                                </Border.Background>
                                <Border.Width>
                                    <MultiBinding Converter="{StaticResource FillWidthConverter}">
                                        <Binding Path="Value" RelativeSource="{RelativeSource TemplatedParent}"/>
                                        <Binding Path="Minimum" RelativeSource="{RelativeSource TemplatedParent}"/>
                                        <Binding Path="Maximum" RelativeSource="{RelativeSource TemplatedParent}"/>
                                        <Binding ElementName="TrackVisual" Path="ActualWidth"/>
                                    </MultiBinding>
                                </Border.Width>
                            </Border>
                        </Grid>

                        <Track x:Name="PART_Track"
                               VerticalAlignment="Center" Height="14" Margin="0,4,0,0"
                               Minimum="{TemplateBinding Minimum}"
                               Maximum="{TemplateBinding Maximum}"
                               Value="{Binding Value, RelativeSource={RelativeSource TemplatedParent}, Mode=TwoWay}"
                               Orientation="Horizontal">

                            <Track.DecreaseRepeatButton>
                                <RepeatButton Style="{StaticResource SliderTrack}"/>
                            </Track.DecreaseRepeatButton>

                            <Track.Thumb>
                                <Thumb Style="{StaticResource SliderThumbTimeline}" Margin="0,-6,0,6"/>
                            </Track.Thumb>

                            <Track.IncreaseRepeatButton>
                                <RepeatButton Style="{StaticResource SliderTrack}"/>
                            </Track.IncreaseRepeatButton>
                        </Track>
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
</ResourceDictionary>