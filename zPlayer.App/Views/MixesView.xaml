<UserControl x:Class="zPlayer.App.Views.MixesView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:core="clr-namespace:zPlayer.Core;assembly=zPlayer.Core"
             xmlns:local="clr-namespace:zPlayer.App.Views"
             xmlns:converters="clr-namespace:zPlayer.App.Converters"
             mc:Ignorable="d" 
             d:DesignHeight="620" d:DesignWidth="1030">
    <UserControl.Resources>
        <converters:ArtworkConverter x:Key="ArtworkConverter"/>
        <Style TargetType="TextBlock" x:Key="MixTitle">
            <Setter Property="Foreground" Value="{StaticResource TextBrush}"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="TextTrimming" Value="CharacterEllipsis"/>
            <Setter Property="HorizontalAlignment" Value="Center"/>
            <Setter Property="ToolTip" Value="{Binding Title}"/>
        </Style>
    </UserControl.Resources>
    
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="24"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!--View Header-->
        <Border Grid.Row="0" Style="{StaticResource PanelTop}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="180"/>
                </Grid.ColumnDefinitions>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                    <TextBlock Text="Mixes" Style="{StaticResource WindowTitle}"/>
                    <TextBlock x:Name="MixesInLibraryText" Text="— 000 in library"
                        Style="{StaticResource WindowTitle}" FontWeight="Normal" Opacity="0.5"/>
                </StackPanel>

                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <ComboBox Name="SortTypeBox" SelectionChanged="SortBox_SelectionChanged"
                              SelectedIndex="0" Style="{StaticResource HeaderComboBox}"
                              MinWidth="75" Margin="0,0,12,0">
                        <ComboBoxItem Content="Title"/>
                        <ComboBoxItem Content="Song Count"/> <!--Change SortOrderBox to "High-Low" and "Low-High" if this, or Length is selected-->
                        <ComboBoxItem Content="Length"/>
                    </ComboBox>
                    <ComboBox x:Name="SortOrderBox" SelectionChanged="SortBox_SelectionChanged"
                              SelectedIndex="0" Style="{StaticResource HeaderComboBox}"
                              MinWidth="75" Margin="0,0,12,0">
                        <ComboBoxItem Content="A-Z"/>
                        <ComboBoxItem Content="Z-A"/>
                    </ComboBox>
                </StackPanel>

                <TextBox x:Name="MixSearchBox" TextChanged="MixSearchBox_TextChanged" Grid.Column="1"
                        Style="{StaticResource SearchBox}" Tag="Search Mixes..." FontSize="12"
                        Width="180" HorizontalAlignment="Right"/>
            </Grid>
        </Border>

        <!--Mixes grid-->
        <ListBox x:Name="MixesGrid" Grid.Row="1"
                 Tag="{Binding RelativeSource={RelativeSource AncestorType={x:Type local:MixesView}}}"
                 ItemContainerStyle="{StaticResource AlbumGridItem}"
                 Background="Transparent"
                 BorderThickness="0"
                 SelectionMode="Extended"
                 MouseDoubleClick="MixesGrid_MouseDoubleClick"
                 PreviewMouseLeftButtonDown="MixesGrid_LeftMouseDown"
                 PreviewMouseRightButtonDown="MixesGrid_RightMouseDown"
                 ContextMenuOpening="MixesGrid_ContextMenuOpening"
                 ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                 ScrollViewer.CanContentScroll="False">
            <ListBox.ContextMenu>
                <ContextMenu Style="{StaticResource RoundedContextMenu}"
                             DataContext="{Binding PlacementTarget, RelativeSource={RelativeSource Self}}">
                    <MenuItem Header="Play" Command="{Binding Tag.Commands.PlayMixCommand}" CommandParameter="{Binding}">
                        <MenuItem.Icon>
                            <Image Source="/Assets/Icons/Play_32x.png"/>
                        </MenuItem.Icon>
                    </MenuItem>
                    <MenuItem Header="Play Next" Command="{Binding Tag.Commands.PlayMixNextCommand}" CommandParameter="{Binding}">
                        <MenuItem.Icon>
                            <Image Source="/Assets/Icons/QueueNext_32x.png"/>
                        </MenuItem.Icon>
                    </MenuItem>
                    <MenuItem Header="Add to Queue" Command="{Binding Tag.Commands.AddMixToQueueCommand}" CommandParameter="{Binding}">
                        <MenuItem.Icon>
                            <Image Source="/Assets/Icons/QueueAdd_32x.png"/>
                        </MenuItem.Icon>
                    </MenuItem>
                    <Separator Style="{StaticResource RoundedSeparator}"/>
                    <MenuItem Header="Edit Info" Command="{Binding Tag.Commands.EditMixCommand}" CommandParameter="{Binding Tag.SingleSelectedMix}">
                        <MenuItem.Icon>
                            <Image Source="/Assets/Icons/Edit_32x.png"/>
                        </MenuItem.Icon>
                    </MenuItem>
                    <MenuItem Header="Delete" Command="{Binding Tag.Commands.DeleteMixCommand}" CommandParameter="{Binding}">
                        <MenuItem.Icon>
                            <Image Source="/Assets/Icons/Remove_32x.png"/>
                        </MenuItem.Icon>
                    </MenuItem>
                </ContextMenu>
            </ListBox.ContextMenu>

            <ListBox.ItemsPanel>
                <ItemsPanelTemplate>
                    <WrapPanel Orientation="Horizontal"/>
                </ItemsPanelTemplate>
            </ListBox.ItemsPanel>

            <ListBox.Resources>
                <DataTemplate DataType="{x:Type core:Mix}">
                    <StackPanel Width="160" Margin="4">
                        <Border Width="160" Height="160" CornerRadius="3">
                            <Border.Background>
                                <ImageBrush ImageSource="{Binding Artwork, Converter={StaticResource ArtworkConverter}}" Stretch="UniformToFill"/>
                            </Border.Background>
                        </Border>

                        <TextBlock Text="{Binding Title}" Style="{StaticResource MixTitle}" Padding="0,2,0,0"/>
                    </StackPanel>
                </DataTemplate>

                <DataTemplate DataType="{x:Type local:CreateMixTile}">
                    <Button Click="CreateMix_Click"
                        Style="{StaticResource ListRowButton}"
                        ToolTip="Create a new Mix">
                        <StackPanel Width="160" Margin="4">
                            <Image Source="/Assets/Icons/Import.png" Width="160" Height="160"/>

                            <TextBlock Text="New Mix" Style="{StaticResource MixTitle}"/>
                        </StackPanel>
                    </Button>
                </DataTemplate>
            </ListBox.Resources>
        </ListBox>
    </Grid>
</UserControl>
