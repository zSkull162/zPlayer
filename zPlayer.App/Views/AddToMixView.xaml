<UserControl x:Class="zPlayer.App.Views.AddToMixView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:zPlayer.App.Views"
             mc:Ignorable="d" 
             Width="300">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="24"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Text="Add songs to a Mix" Style="{StaticResource WindowTitle}" HorizontalAlignment="Center"/>

        <Border Style="{StaticResource Panel}" Margin="4" Height="150" Grid.Row="1">
            <!--List of all mixes with a checkbox here-->
        </Border>

        <Button Click="Done_Click" Content="Done" Style="{StaticResource RoundedButton}"
                Margin="4" Padding="12,4" Width="64" Grid.Row="2"
                HorizontalAlignment="Right"/>
    </Grid>
</UserControl>
