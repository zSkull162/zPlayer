<UserControl x:Class="zPlayer.App.Views.AlbumsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:core="clr-namespace:zPlayer.Core;assembly=zPlayer.Core"
             xmlns:local="clr-namespace:zPlayer.App.Views"
             xmlns:converters="clr-namespace:zPlayer.App.Converters"
             mc:Ignorable="d" 
             Height="620" Width="1030">
    <UserControl.Resources>
        <converters:ArtworkConverter x:Key="ArtworkConverter"/>
        <Style TargetType="TextBlock" x:Key="AlbumTitle">
            <Setter Property="Foreground" Value="{StaticResource TextBrush}"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="TextTrimming" Value="CharacterEllipsis"/>
            <Setter Property="HorizontalAlignment" Value="Center"/>
            <Setter Property="ToolTip" Value="{Binding Title}"/>
        </Style>
        <Style TargetType="TextBlock" x:Key="AlbumArtist">
            <Setter Property="Foreground" Value="{StaticResource TextBrush}"/>
            <Setter Property="FontSize" Value="10"/>
            <Setter Property="Opacity" Value="0.5"/>
            <Setter Property="TextTrimming" Value="CharacterEllipsis"/>
            <Setter Property="HorizontalAlignment" Value="Center"/>
            <Setter Property="ToolTip" Value="{Binding Artist}"/>
        </Style>
    </UserControl.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="24"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!--View Header-->
        <Border Grid.Row="0" Style="{StaticResource PanelTop}">
            <Grid Grid.Row="0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="180"/>
                </Grid.ColumnDefinitions>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                    <TextBlock Text="Albums" Style="{StaticResource WindowTitle}"/>
                    <TextBlock x:Name="AlbumsInLibraryText" Text="— 000 in library"
                        Style="{StaticResource WindowTitle}" FontWeight="Normal" Opacity="0.5"/>
                </StackPanel>

                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <ComboBox Name="SortTypeBox" SelectionChanged="SortBox_SelectionChanged"
                              SelectedIndex="0" Style="{StaticResource HeaderComboBox}"
                              MinWidth="75" Margin="0,0,12,0">
                        <ComboBoxItem Content="Title"/>
                        <ComboBoxItem Content="Artist"/>
                        <ComboBoxItem Content="Length"/> <!--Change SortOrderBox to "High-Low" and "Low-High" if this is selected-->
                    </ComboBox>
                    <ComboBox x:Name="SortOrderBox" SelectionChanged="SortBox_SelectionChanged"
                              SelectedIndex="0" Style="{StaticResource HeaderComboBox}"
                              MinWidth="75" Margin="0,0,12,0">
                        <ComboBoxItem Content="A-Z"/>
                        <ComboBoxItem Content="Z-A"/>
                    </ComboBox>
                </StackPanel>

                <TextBox x:Name="AlbumSearchBox" TextChanged="AlbumSearchBox_TextChanged"
                        Style="{StaticResource SearchBox}" Tag="Search Albums..." FontSize="12"
                        Grid.Column="1" Width="180" HorizontalAlignment="Right"/>
            </Grid>
        </Border>
        
        <!--Albums grid-->
        <ListBox x:Name="AlbumsGrid" Grid.Row="1"
                 Tag="{Binding Commands, RelativeSource={RelativeSource AncestorType={x:Type local:AlbumsView}}}"
                 ItemContainerStyle="{StaticResource AlbumGridItem}"
                 Background="Transparent"
                 BorderThickness="0"
                 SelectionMode="Extended"
                 MouseDoubleClick="AlbumsGrid_MouseDoubleClick"
                 PreviewMouseLeftButtonDown="AlbumsGrid_LeftMouseDown"
                 PreviewMouseRightButtonDown="AlbumsGrid_RightMouseDown"
                 ContextMenuOpening="AlbumsGrid_ContextMenuOpening"
                 ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                 ScrollViewer.CanContentScroll="False">

            <ListBox.ContextMenu>
                <ContextMenu Style="{StaticResource RoundedContextMenu}"
                             DataContext="{Binding PlacementTarget, RelativeSource={RelativeSource Self}}">
                    <MenuItem Header="Play" Command="{Binding Tag.PlayAlbumsCommand}" CommandParameter="{Binding}">
                        <MenuItem.Icon>
                            <Image Source="/Assets/Icons/Play_32x.png"/>
                        </MenuItem.Icon>
                    </MenuItem>
                    <MenuItem Header="Play Next" Command="{Binding Tag.PlayAlbumsNextCommand}" CommandParameter="{Binding}">
                        <MenuItem.Icon>
                            <Image Source="/Assets/Icons/QueueNext_32x.png"/>
                        </MenuItem.Icon>
                    </MenuItem>
                    <MenuItem Header="Add to Queue" Command="{Binding Tag.AddAlbumsToQueueCommand}" CommandParameter="{Binding}">
                        <MenuItem.Icon>
                            <Image Source="/Assets/Icons/QueueAdd_32x.png"/>
                        </MenuItem.Icon>
                    </MenuItem>
                    <Separator Style="{StaticResource RoundedSeparator}"/>
                    <MenuItem Header="Edit Info" Command="{Binding Tag.EditAlbumsCommand}" CommandParameter="{Binding}">
                        <MenuItem.Icon>
                            <Image Source="/Assets/Icons/Edit_32x.png"/>
                        </MenuItem.Icon>
                    </MenuItem>
                    <MenuItem Header="Delete" Command="{Binding Tag.DeleteAlbumsCommand}" CommandParameter="{Binding}">
                        <MenuItem.Icon>
                            <Image Source="/Assets/Icons/Remove_32x.png"/>
                        </MenuItem.Icon>
                    </MenuItem>
                    <Separator Style="{StaticResource RoundedSeparator}"/>
                    <MenuItem Header="Add Songs to Mix">
                        <MenuItem.Icon>
                            <Image Source="/Assets/Icons/MixAdd_32x.png"/>
                        </MenuItem.Icon>
                    </MenuItem>
                </ContextMenu>
            </ListBox.ContextMenu>

            <ListBox.ItemsPanel>
                <ItemsPanelTemplate>
                    <WrapPanel Orientation="Horizontal"/>
                </ItemsPanelTemplate>
            </ListBox.ItemsPanel>

            <ListBox.Resources>
                <DataTemplate DataType="{x:Type core:Album}">
                    <StackPanel Width="160" Margin="4">
                        <Border Width="160" Height="160" CornerRadius="3">
                            <Border.Background>
                                <ImageBrush ImageSource="{Binding Artwork, Converter={StaticResource ArtworkConverter}}" Stretch="UniformToFill"/>
                            </Border.Background>
                        </Border>

                        <TextBlock Text="{Binding Title}" Style="{StaticResource AlbumTitle}"/>
                        <TextBlock Text="{Binding Artist}" Style="{StaticResource AlbumArtist}"/>
                    </StackPanel>
                </DataTemplate>

                <DataTemplate DataType="{x:Type local:CreateAlbumTile}">
                    <Button Click="CreateAlbum_Click"
                        Style="{StaticResource ListRowButton}"
                        ToolTip="Create an album">
                        <StackPanel Width="160" Margin="4">
                            <Image Source="/Assets/Icons/Import.png" Width="160" Height="160"/>

                            <TextBlock Text="New Album" Style="{StaticResource AlbumTitle}"/>
                            <TextBlock Text="Create a new album" Style="{StaticResource AlbumArtist}"/>
                        </StackPanel>
                    </Button>
                </DataTemplate>
            </ListBox.Resources>
        </ListBox>
    </Grid>
</UserControl>
