<UserControl x:Class="zPlayer.App.Views.MoveToAlbumView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:art="clr-namespace:zPlayer.App.Artwork"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:zPlayer.App.Views"
             xmlns:converters="clr-namespace:zPlayer.App.Converters"
             mc:Ignorable="d"
             Height="320" Width="300">
    <UserControl.Resources>

    </UserControl.Resources>
    
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="30"/>
            <RowDefinition Height="30"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="8"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="42"/>
        </Grid.RowDefinitions>

        <TextBlock Text="Move Song to Album" Style="{StaticResource WindowTitle}"
                   HorizontalAlignment="Center" Margin="0,0,0,4"/>
        <TextBlock Text="{Binding Title}" FontSize="18" Foreground="{DynamicResource TextBrush}"
                   TextTrimming="CharacterEllipsis" Grid.Row="1"
                   HorizontalAlignment="Center" Margin="0,0,0,4"/>

        <Grid x:Name="FromGrid" Opacity="0.5" Margin="6" Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="{Binding ActualHeight, ElementName=FromGrid}"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <Border CornerRadius="3" art:CoverArt.Reference="{Binding SourceAlbum.Cover, RelativeSource={RelativeSource AncestorType={x:Type local:MoveToAlbumView}}}" art:CoverArt.Enabled="True">
            </Border>

            <StackPanel Margin="8,0,0,2" Grid.Column="1">
                <TextBlock Text="From" FontSize="16" FontStyle="Italic" Foreground="{DynamicResource TextBrush}"/>
                <TextBox IsEnabled="False" Style="{StaticResource RoundedTextBox}" Text="{Binding AlbumTitle, Mode=OneWay}"
                         Height="30" Margin="0,4" Padding="2,0"/>
            </StackPanel>
        </Grid>
        
        <Separator Grid.Row="3" Margin="12,0" Style="{StaticResource RoundedSeparator}"/>
        
        <Grid x:Name="ToGrid" Margin="6" Grid.Row="4">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="{Binding ActualHeight, ElementName=ToGrid}"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <Border CornerRadius="3" art:CoverArt.Reference="{Binding SelectedItem.Cover, ElementName=AlbumBox}" art:CoverArt.Enabled="True">
            </Border>

            <StackPanel Margin="8,0,0,2" Grid.Column="1">
                <TextBlock Text="To" FontSize="16" Foreground="{DynamicResource TextBrush}"/>
                <ComboBox x:Name="AlbumBox" DisplayMemberPath="Title" SelectionChanged="AlbumBox_SelectionChanged"
                        Style="{StaticResource RoundedComboBox}" Grid.Column="1" Height="30"  Margin="0,4"/>
            </StackPanel>
        </Grid>

        <StackPanel Grid.Row="5" Orientation="Horizontal" HorizontalAlignment="Right">
            <Button Click="Cancel_Click" Content="Cancel" Style="{StaticResource RoundedButton}" Margin="4" Padding="12,4"/>
            <Button x:Name="MoveButton" IsEnabled="False" Click="Move_Click" Content="Move"
                    Style="{StaticResource RoundedButton}" Margin="4,4,0,4" Padding="12,4"/>
        </StackPanel>
    </Grid>
</UserControl>
