<UserControl x:Class="zPlayer.App.Views.SettingsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:zPlayer.App.Views"
             xmlns:colorpicker="clr-namespace:ColorPicker;assembly=ColorPicker"
             mc:Ignorable="d"
             d:DesignHeight="620" d:DesignWidth="1030">
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="pack://application:,,,/ColorPicker;component/Styles/DefaultColorPickerStyle.xaml" />
            </ResourceDictionary.MergedDictionaries>
            <Style x:Key="ToggleLabel" TargetType="TextBlock">
                <Setter Property="Foreground" Value="{DynamicResource TextBrush}"/>
                <Setter Property="HorizontalAlignment" Value="Left"/>
                <Setter Property="VerticalAlignment" Value="Center"/>
                <Setter Property="Margin" Value="6,0,0,0"/>
                <Setter Property="Padding" Value="4,8"/>
                <Setter Property="FontSize" Value="15"/>
            </Style>
            <Style BasedOn="{StaticResource RoundedCheckbox}" x:Key="SettingsCheckbox" TargetType="CheckBox">
                <Setter Property="HorizontalAlignment" Value="Right"/>
                <Setter Property="Padding" Value="4,4,0,4"/>
            </Style>
            <Style x:Key="ColorPickerIcon" TargetType="Image">
                <Setter Property="Source" Value="/Assets/Icons/Edit_32x.png"/>
                <Setter Property="Width" Value="15"/>
                <Setter Property="Margin" Value="6"/>
                <Setter Property="HorizontalAlignment" Value="Left"/>
            </Style>
            <Style x:Key="ColorPicker" BasedOn="{StaticResource DefaultColorPickerStyle}" TargetType="colorpicker:PortableColorPicker">
                <Setter Property="ShowAlpha" Value="False"/>
            </Style>
            <Style x:Key="ColorPickerBorder" TargetType="Border">
                <Setter Property="Margin" Value="0,4,4,4"/>
                <Setter Property="MinWidth" Value="86"/>
                <Setter Property="Height" Value="24"/>
                <Setter Property="CornerRadius" Value="6"/>
                <Setter Property="ClipToBounds" Value="True"/>
            </Style>
        </ResourceDictionary>
    </UserControl.Resources>
    
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="24"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>
        
        <!--View Header-->
        <Border Grid.Row="0" Style="{StaticResource PanelTop}">
            <TextBlock Text="zPlayer Settings" HorizontalAlignment="Center" Style="{StaticResource WindowTitle}"/>
        </Border>

        <!--Settings-->
        <Grid Grid.Row="1" Margin="8,2,4,0">
            <ScrollViewer HorizontalScrollBarVisibility="Disabled">
                <StackPanel Grid.Row="1" Orientation="Vertical" Margin="0,0,4,0">
                    <Border Style="{StaticResource Panel}" CornerRadius="3" Margin="0,6">
                        <Grid>
                            <TextBlock Style="{StaticResource ToggleLabel}" Text="Audio output"/>
                            <ComboBox x:Name="AudioOutputBox" Style="{StaticResource RoundedComboBox}"
                                                  HorizontalAlignment="Right" Margin="8" SelectionChanged="SettingComboBox_SelectionChanged"/>
                        </Grid>
                    </Border>

                    <Border Style="{StaticResource Panel}" CornerRadius="3" Margin="0,6">
                        <Grid>
                            <TextBlock Style="{StaticResource ToggleLabel}" Text="Audio Normalization"/>
                            <CheckBox x:Name="AudioNormalizationToggle" Style="{StaticResource SettingsCheckbox}" Click="SettingToggle_Click"/>
                        </Grid>
                    </Border>

                    <Border Style="{StaticResource Panel}" CornerRadius="3" Margin="0,6">
                        <Grid>
                            <TextBlock Style="{StaticResource ToggleLabel}" Text="Allow duplicate songs in playback queue"/>
                            <CheckBox x:Name="DuplicateSongToggle" Style="{StaticResource SettingsCheckbox}" Click="SettingToggle_Click"/>
                        </Grid>
                    </Border>

                    <!--Discord RPC settings-->
                    <Border Style="{StaticResource Panel}" CornerRadius="3" Margin="0,6">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="*"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>
                            <TextBlock Style="{StaticResource ToggleLabel}" Text="Discord Rich Presence"/>
                            <CheckBox x:Name="RpcToggle" Style="{StaticResource SettingsCheckbox}" Click="SettingToggle_Click"/>

                            <StackPanel x:Name="RpcOptions" Grid.Row="1" Orientation="Vertical" Margin="12,0,0,0" Visibility="Collapsed">
                                <Separator Style="{StaticResource RoundedSeparator}"/>
                                <Grid>
                                    <TextBlock Style="{StaticResource ToggleLabel}" Text="Display paused state"/>
                                    <CheckBox x:Name="RpcDisplayPausedToggle" Style="{StaticResource SettingsCheckbox}" Click="SettingToggle_Click"/>
                                </Grid>
                                <Grid>
                                    <TextBlock Style="{StaticResource ToggleLabel}" Text="Display album"/>
                                    <CheckBox x:Name="RpcDisplayAlbumToggle" Style="{StaticResource SettingsCheckbox}" Click="SettingToggle_Click"/>
                                </Grid>
                                <Grid>
                                    <TextBlock Style="{StaticResource ToggleLabel}" Text="Status Type"/>
                                    <ComboBox x:Name="RpcStatusBox" Style="{StaticResource RoundedComboBox}"
                                                          SelectedIndex="2" HorizontalAlignment="Right" Margin="8"
                                                          SelectionChanged="SettingComboBox_SelectionChanged">
                                        <ComboBoxItem Content="App name"/>
                                        <ComboBoxItem Content="Song title"/>
                                        <ComboBoxItem Content="Song artist"/>
                                    </ComboBox>
                                </Grid>
                                <Separator Style="{StaticResource RoundedSeparator}"/>
                                <TextBlock Style="{StaticResource Header}" Text="Example Status" FontSize="12" Margin="10,0,0,0"/>
                                <Grid Margin="16,8,0,8"> <!--User list status preview-->
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="46"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="23"/>
                                        <RowDefinition Height="23"/>
                                    </Grid.RowDefinitions>
                                    <Ellipse Grid.RowSpan="2" Width="46" Height="46">
                                        <Ellipse.Fill>
                                            <ImageBrush ImageSource="/Assets/Icons/DefaultPFP.png" Stretch="Fill"/>
                                        </Ellipse.Fill>
                                    </Ellipse>
                                    <Ellipse Grid.Row="1" Width="22" Height="22" Fill="ForestGreen" StrokeThickness="4" Stroke="{DynamicResource SurfaceBrush}"
                                                   HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="-3"/>

                                    <TextBlock Grid.Column="1" Foreground="{DynamicResource TextBrush}" Text="Username" FontSize="18" FontWeight="Bold" Margin="12,0,0,0"/>
                                    <StackPanel Grid.Column="1" Grid.Row="1" Orientation="Horizontal" Margin="12,0,0,0">
                                        <Image Source="/Assets/Icons/MusicGreen_32x.png" Stretch="Uniform" Margin="0,4,6,4"/>
                                        <TextBlock x:Name="PreviewUserArtistText" Foreground="{DynamicResource TextBrush}" Text="Artist" FontSize="14" VerticalAlignment="Center"/>
                                    </StackPanel>
                                </Grid>
                                <Separator Style="{StaticResource RoundedSeparator}"/>
                                <TextBlock Foreground="{DynamicResource TextBrush}" Text="Listening to zPlayer" FontSize="14" Margin="10,0,0,0"/>
                                <Grid Margin="4,8,0,4"> <!--Expanded status preview-->
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="100"/>
                                        <ColumnDefinition Width="260"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="25"/>
                                        <RowDefinition Height="25"/>
                                        <RowDefinition Height="25"/>
                                        <RowDefinition Height="25"/>
                                    </Grid.RowDefinitions>
                                    <Image Grid.RowSpan="4" Source="/Assets/zPlayerImage.png" Height="100" Stretch="Fill"/>

                                    <TextBlock Grid.Column="1" Foreground="{DynamicResource TextBrush}" Text="Song Title" FontSize="16" FontWeight="Bold"/>
                                    <TextBlock Grid.Column="1" Grid.Row="1" Foreground="{DynamicResource TextBrush}" Text="Artist" FontSize="14"/>
                                    <TextBlock x:Name="PreviewAlbumText" Grid.Column="1" Grid.Row="2" Foreground="{DynamicResource TextBrush}" Text="Album Name" FontSize="14"/>

                                    <StackPanel x:Name="PreviewProgressBar" Orientation="Horizontal" Grid.Column="1" Grid.Row="3" Visibility="Visible">
                                        <TextBlock Grid.Column="1" Grid.Row="3" Foreground="{DynamicResource TextBrush}" Text="01:30"
                                                             FontFamily="Cascadia Code"  FontSize="14" VerticalAlignment="Center"/>
                                        <Grid Margin="8,0">
                                            <Rectangle Fill="Gray" Width="150" Height="2" RadiusX="1" RadiusY="1" Opacity="0.5"/>
                                            <Rectangle Fill="White" Width="75" Height="2" RadiusX="1" RadiusY="1" HorizontalAlignment="Left"/>
                                        </Grid>
                                        <TextBlock Grid.Column="1" Grid.Row="3" Foreground="{DynamicResource TextBrush}" Text="03:00"
                                                             FontFamily="Cascadia Code" FontSize="14" VerticalAlignment="Center"/>
                                    </StackPanel>

                                    <StackPanel x:Name="PreviewPausedInfo" Orientation="Horizontal" Grid.Column="1" Grid.Row="3" Visibility="Collapsed">
                                        <Image Source="/Assets/Icons/MusicGreen_32x.png" Stretch="Uniform" Margin="0,4,6,4"/>
                                        <TextBlock Foreground="ForestGreen" Text="0:00" FontSize="15" FontFamily="Cascadia Code" VerticalAlignment="Center"/>
                                    </StackPanel>

                                    <Button x:Name="PreviewPlayPauseButton" Style="{StaticResource IconButton}" Click="PreviewPlayPause_Click"
                                                  Grid.Column="2" Grid.Row="3" HorizontalAlignment="Left" Width="25">
                                        <Image x:Name="PreviewPlayPauseIcon" Source="/Assets/Icons/Play_32x.png" Stretch="UniformToFill" Margin="2"/>
                                    </Button>
                                </Grid>
                            </StackPanel>
                        </Grid>
                    </Border>

                    <Separator Style="{StaticResource RoundedSeparator}" Height="8"/>

                    <!--Color options-->
                    <Border Style="{StaticResource Panel}" CornerRadius="3" Margin="0,6">
                        <StackPanel Orientation="Vertical">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="46"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Style="{StaticResource ToggleLabel}" Text="Background - Primary"/>
                                <Rectangle Grid.Column="1" Margin="8,0" Height="4" Fill="{DynamicResource BackgroundBrush}" RadiusX="2" RadiusY="2"/>
                                <Border Grid.Column="2" Style="{StaticResource ColorPickerBorder}">
                                    <colorpicker:PortableColorPicker x:Name="BackgroundPicker" Tag="BackgroundColor" Style="{StaticResource ColorPicker}" ColorChanged="ThemeColor_Changed"/>
                                </Border>
                                <Image Grid.Column="2" Style="{StaticResource ColorPickerIcon}"/>
                                <Button Grid.Column="3" Tag="ResetBackground" Click="ResetColor_Click" Height="36"
                                              FontSize="14" Style="{StaticResource RoundedButton}" Margin="4">
                                    <Image Source="/Assets/Icons/Undo_32x.png" Margin="4.5"/>
                                </Button>
                            </Grid>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="46"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Style="{StaticResource ToggleLabel}" Text="Background - Secondary"/>
                                <Rectangle Grid.Column="1" Margin="8,0" Height="4" Fill="{DynamicResource SurfaceBrush}" RadiusX="2" RadiusY="2"/>
                                <Border Grid.Column="2" Style="{StaticResource ColorPickerBorder}">
                                    <colorpicker:PortableColorPicker x:Name="SurfacePicker" Tag="SurfaceColor" Style="{StaticResource ColorPicker}" ColorChanged="ThemeColor_Changed"/>
                                </Border>
                                <Image Grid.Column="2" Style="{StaticResource ColorPickerIcon}"/>
                                <Button Grid.Column="3" Tag="ResetSurface" Click="ResetColor_Click" Height="36"
                                              FontSize="14" Style="{StaticResource RoundedButton}" Margin="4">
                                    <Image Source="/Assets/Icons/Undo_32x.png" Margin="4.5"/>
                                </Button>
                            </Grid>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="46"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Style="{StaticResource ToggleLabel}" Text="Border"/>
                                <Rectangle Grid.Column="1" Margin="8,0" Height="4" Fill="{DynamicResource BorderBrush}" RadiusX="2" RadiusY="2"/>
                                <Border Grid.Column="2" Style="{StaticResource ColorPickerBorder}">
                                    <colorpicker:PortableColorPicker x:Name="BorderPicker" Tag="BorderColor" Style="{StaticResource ColorPicker}" ColorChanged="ThemeColor_Changed"/>
                                </Border>
                                <Image Grid.Column="2" Style="{StaticResource ColorPickerIcon}"/>
                                <Button Grid.Column="3" Tag="ResetBorder" Click="ResetColor_Click" Height="36"
                                              FontSize="14" Style="{StaticResource RoundedButton}" Margin="4">
                                    <Image Source="/Assets/Icons/Undo_32x.png" Margin="4.5"/>
                                </Button>
                            </Grid>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="46"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Style="{StaticResource ToggleLabel}" Text="Highlight"/>
                                <Rectangle Grid.Column="1" Margin="8,0" Height="4" Fill="{DynamicResource HighlightBrush}" RadiusX="2" RadiusY="2"/>
                                <Border Grid.Column="2" Style="{StaticResource ColorPickerBorder}">
                                    <colorpicker:PortableColorPicker x:Name="HighlightPicker" Tag="HighlightColor" Style="{StaticResource ColorPicker}" ColorChanged="ThemeColor_Changed"/>
                                </Border>
                                <Image Grid.Column="2" Style="{StaticResource ColorPickerIcon}"/>
                                <Button Grid.Column="3" Tag="ResetHighlight" Click="ResetColor_Click" Height="36"
                                              FontSize="14" Style="{StaticResource RoundedButton}" Margin="4">
                                    <Image Source="/Assets/Icons/Undo_32x.png" Margin="4.5"/>
                                </Button>
                            </Grid>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="46"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Style="{StaticResource ToggleLabel}" Text="Accent - Primary"/>
                                <Rectangle Grid.Column="1" Margin="8,0" Height="4" RadiusX="2" RadiusY="2">
                                    <Rectangle.Fill>
                                        <LinearGradientBrush>
                                            <GradientStop Color="{DynamicResource SelectedColor}" Offset="0.6"/>
                                            <GradientStop Color="{DynamicResource SelectedColorSecondary}" Offset="1"/>
                                        </LinearGradientBrush>
                                    </Rectangle.Fill>
                                </Rectangle>
                                <Border Grid.Column="2" Style="{StaticResource ColorPickerBorder}">
                                    <colorpicker:PortableColorPicker x:Name="SelectedPicker" Tag="SelectedColor" Style="{StaticResource ColorPicker}" ColorChanged="ThemeColor_Changed"/>
                                </Border>
                                <Image Grid.Column="2" Style="{StaticResource ColorPickerIcon}"/>
                                <Button Grid.Column="3" Tag="ResetSelected" Click="ResetColor_Click" Height="36"
                                              FontSize="14" Style="{StaticResource RoundedButton}" Margin="4">
                                    <Image Source="/Assets/Icons/Undo_32x.png" Margin="4.5"/>
                                </Button>
                            </Grid>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="46"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Style="{StaticResource ToggleLabel}" Text="Accent - Secondary"/>
                                <Rectangle Grid.Column="1" Margin="8,0" Height="4" RadiusX="2" RadiusY="2">
                                    <Rectangle.Fill>
                                        <LinearGradientBrush>
                                            <GradientStop Color="{DynamicResource SelectedColorSecondary}" Offset="0.6"/>
                                            <GradientStop Color="{DynamicResource SelectedColor}" Offset="1"/>
                                        </LinearGradientBrush>
                                    </Rectangle.Fill>
                                </Rectangle>
                                <Border Grid.Column="2" Style="{StaticResource ColorPickerBorder}">
                                    <colorpicker:PortableColorPicker x:Name="SelectedPickerSecondary" Tag="SelectedColorSecondary" Style="{StaticResource ColorPicker}" ColorChanged="ThemeColor_Changed"/>
                                </Border>
                                <Image Grid.Column="2" Style="{StaticResource ColorPickerIcon}"/>
                                <Button Grid.Column="3" Tag="ResetSelectedSecondary" Click="ResetColor_Click" Height="36"
                                              FontSize="14" Style="{StaticResource RoundedButton}" Margin="4">
                                    <Image Source="/Assets/Icons/Undo_32x.png" Margin="4.5"/>
                                </Button>
                            </Grid>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="46"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Style="{StaticResource ToggleLabel}" Text="Text"/>
                                <Rectangle Grid.Column="1" Margin="8,0" Height="4" Fill="{DynamicResource TextBrush}" RadiusX="2" RadiusY="2"/>
                                <Border Grid.Column="2" Style="{StaticResource ColorPickerBorder}">
                                    <colorpicker:PortableColorPicker x:Name="TextPicker" Tag="TextColor" Style="{StaticResource ColorPicker}" ColorChanged="ThemeColor_Changed"/>
                                </Border>
                                <Image Grid.Column="2" Style="{StaticResource ColorPickerIcon}"/>
                                <Button Grid.Column="3" Tag="ResetText" Click="ResetColor_Click" Height="36"
                                              FontSize="14" Style="{StaticResource RoundedButton}" Margin="4">
                                    <Image Source="/Assets/Icons/Undo_32x.png" Margin="4.5"/>
                                </Button>
                            </Grid>
                        </StackPanel>
                    </Border>

                    <Separator Style="{StaticResource RoundedSeparator}" Height="8"/>

                    <Border Style="{StaticResource Panel}" CornerRadius="3" Margin="0,6">
                        <Grid>
                            <TextBlock Style="{StaticResource ToggleLabel}" Text="Show summary on song import"/>
                            <CheckBox x:Name="ImportSummaryToggle" Style="{StaticResource SettingsCheckbox}" Click="SettingToggle_Click"/>
                        </Grid>
                    </Border>
                    <Border Style="{StaticResource Panel}" CornerRadius="3" Margin="0,6">
                        <Grid>
                            <TextBlock Style="{StaticResource ToggleLabel}" Text="Show confirmation when deleting songs"/>
                            <CheckBox x:Name="SongDeleteConfirmationToggle" Style="{StaticResource SettingsCheckbox}" Click="SettingToggle_Click"/>
                        </Grid>
                    </Border>
                    <Border Style="{StaticResource Panel}" CornerRadius="3" Margin="0,6">
                        <Grid>
                            <TextBlock Style="{StaticResource ToggleLabel}" Text="Show confirmation when deleting albums"/>
                            <CheckBox x:Name="AlbumDeleteConfirmationToggle" Style="{StaticResource SettingsCheckbox}" Click="SettingToggle_Click"/>
                        </Grid>
                    </Border>
                    <Border Style="{StaticResource Panel}" CornerRadius="3" Margin="0,6">
                        <Grid>
                            <TextBlock Style="{StaticResource ToggleLabel}" Text="Show confirmation when deleting mixes"/>
                            <CheckBox x:Name="MixDeleteConfirmationToggle" Style="{StaticResource SettingsCheckbox}" Click="SettingToggle_Click"/>
                        </Grid>
                    </Border>
                </StackPanel>
            </ScrollViewer>
        </Grid>
    </Grid>
</UserControl>
