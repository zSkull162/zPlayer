<UserControl x:Class="zPlayer.App.Views.MultiEditView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:zPlayer.App.Views"
             mc:Ignorable="d" 
             Width="400">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="24"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock x:Name="ViewTitle" Text="Editing Multiple Songs" Style="{StaticResource WindowTitle}" HorizontalAlignment="Center"/>

        <StackPanel Grid.Row="2" Margin="12,6">
            <!--Art mode-->
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="0.5*"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                <TextBlock Text="Artwork Mode" Style="{StaticResource FieldLabel}"/>

                <Grid Grid.Column="1">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <ComboBox Name="ArtworkModeBox" SelectedIndex="0" Style="{StaticResource RoundedComboBox}"
                            SelectionChanged="ArtworkModeBox_SelectionChanged" Height="30"  Margin="0,4">
                        <ComboBoxItem Content="Don't Change"/>
                        <ComboBoxItem x:Name="AutomaticArtworkItem" Content="Automatic"/>
                        <ComboBoxItem Content="Custom Image"/>
                    </ComboBox>

                    <Button x:Name="BrowseArtworkButton" Click="BrowseArtwork_Click" Grid.Column="1"
                        Content="Browse..." Style="{StaticResource RoundedButton}"
                        Height="30" Margin="4,4,0,4" Padding="12,0" Visibility="Collapsed"/>
                </Grid>

                <TextBlock x:Name="CustomImageFilePathText" Text="Test/File/Path.png" Grid.Row="1" Grid.ColumnSpan="2"
                           Foreground="{StaticResource TextBrush}" Opacity="0.5" Visibility="Collapsed"
                           FontSize="10" FontStyle="Italic" HorizontalAlignment="Right"/>
            </Grid>

            <Separator Height="13" Background="{StaticResource BorderBrush}"/>

            <!--Artist-->
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="0.5*"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <TextBlock Text="Artist" Style="{StaticResource FieldLabel}"/>

                <TextBox x:Name="ArtistTextBox" Text="-" Style="{StaticResource RoundedTextBox}"
                         Grid.Column="1" Height="30" Margin="0,4" Padding="2,0"
                         ToolTip="Leaving as a '-' will ensure this value is not saved"/>
            </Grid>

            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,12,0,0">
                <Button Click="Cancel_Click" Content="Cancel" Style="{StaticResource RoundedButton}" Margin="4" Padding="12,4"/>
                <Button Click="Save_Click" Content="Save Changes" Style="{StaticResource RoundedButton}" Margin="4,4,0,4" Padding="12,4"/>
            </StackPanel>
        </StackPanel>
    </Grid>
</UserControl>
