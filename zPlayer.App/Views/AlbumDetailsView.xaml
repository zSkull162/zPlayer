<UserControl x:Class="zPlayer.App.Views.AlbumDetailsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:art="clr-namespace:zPlayer.App.Artwork"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:zPlayer.App.Views"
             xmlns:converters="clr-namespace:zPlayer.App.Converters"
             mc:Ignorable="d" 
             d:DesignHeight="620" d:DesignWidth="1030">
    <UserControl.Resources>
        <Style TargetType="TextBlock" x:Key="AlbumTitle">
            <Setter Property="Foreground" Value="{DynamicResource TextBrush}"/>
            <Setter Property="Padding" Value="6,0,0,0"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="HorizontalAlignment" Value="Left"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="FontSize" Value="20"/>
            <Setter Property="TextTrimming" Value="CharacterEllipsis"/>
        </Style>
        <Style TargetType="TextBlock" x:Key="AlbumArtist">
            <Setter Property="Foreground" Value="{DynamicResource TextBrush}"/>
            <Setter Property="Padding" Value="6,0,0,0"/>
            <Setter Property="VerticalAlignment" Value="Top"/>
            <Setter Property="HorizontalAlignment" Value="Left"/>
            <Setter Property="Opacity" Value="0.5"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="TextTrimming" Value="CharacterEllipsis"/>
        </Style>
        <Style TargetType="TextBlock" x:Key="AlbumInfo">
            <Setter Property="Foreground" Value="{DynamicResource TextBrush}"/>
            <Setter Property="Padding" Value="6,6,0,0"/>
            <Setter Property="VerticalAlignment" Value="Top"/>
            <Setter Property="HorizontalAlignment" Value="Left"/>
            <Setter Property="Opacity" Value="0.3"/>
            <Setter Property="FontSize" Value="12"/>
        </Style>
    </UserControl.Resources>
    
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="24"/>
            <RowDefinition Height="160"/>
            <RowDefinition Height="24"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>
        
        <!--View Header-->
        <Border Grid.Row="0" Style="{StaticResource PanelTop}">
            <Grid Grid.Row="0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="26"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="26"/>
                </Grid.ColumnDefinitions>
                <Button Click="BackButton_Click" Style="{StaticResource IconButton}"
                        HorizontalAlignment="Left" Grid.Column="0" Opacity="0.5">
                    <Image Source="/Assets/Icons/ArrowBack_32x.png" Margin="3"/>
                </Button>
                
                <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Center">
                    <TextBlock Text="Album Details" Padding="0,0,4,0"
                            Style="{StaticResource WindowTitle}"/>
                    <TextBlock x:Name="AlbumTitleText" Text="— AlbumTitle" TextTrimming="CharacterEllipsis"
                            Style="{StaticResource WindowTitle}" FontWeight="Normal" Opacity="0.5"/>
                </StackPanel>
            </Grid>
        </Border>

        <!--Album Info-->
        <Border Grid.Row="1" Style="{StaticResource Panel}" CornerRadius="3" Margin="2">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="150"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="36"/>
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="36"/> <!--Title-->
                    <RowDefinition Height="24"/> <!--Artist-->
                    <RowDefinition Height="*"/> 
                    <RowDefinition Height="40"/> <!--Actions-->
                </Grid.RowDefinitions>

                <Border CornerRadius="3" Grid.Column="0" Grid.RowSpan="4" art:CoverArt.Reference="{Binding Cover}" art:CoverArt.Enabled="True"/>

                <TextBlock Text="{Binding Title}" Style="{StaticResource AlbumTitle}" Grid.Column="1"/>
                <TextBlock Text="{Binding Artist}" Style="{StaticResource AlbumArtist}" Grid.Column="1" Grid.Row="1"/>

                <TextBlock x:Name="AlbumInfoText" Text="000 Songs — 00:00"
                        Style="{StaticResource AlbumInfo}" Grid.Column="1" Grid.Row="2"/>

                <StackPanel Orientation="Horizontal" Grid.Row="3" Grid.Column="1">
                    <Button Click="PlayAlbum_Click" Style="{StaticResource IconButton}"
                            HorizontalAlignment="Left" Margin="6" ToolTip="Play and replace queue">
                        <Image Source="/Assets/Icons/Play_32x.png"/>
                    </Button>
                    <Button Click="AddToQueue_Click" Style="{StaticResource IconButton}"
                            HorizontalAlignment="Left" Margin="6" ToolTip="Add songs to queue">
                        <Image Source="/Assets/Icons/QueueAdd_32x.png"/>
                    </Button>
                    <Button Click="InsertInQueue_Click" Style="{StaticResource IconButton}"
                            HorizontalAlignment="Left" Margin="6" ToolTip="Add songs to queue after current song">
                        <Image Source="/Assets/Icons/QueueNext_32x.png"/>
                    </Button>
                </StackPanel>

                <Button Click="EditAlbum_Click" Style="{StaticResource IconButton}"
                        HorizontalAlignment="Right" Grid.Column="2" Margin="6">
                    <Image Source="/Assets/Icons/Edit_32x.png"/>
                </Button>
            </Grid>
        </Border>

        <!--Songs column headers-->
        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="36"/>
                <ColumnDefinition Width="50"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="100"/>
                <ColumnDefinition Width="52"/>
            </Grid.ColumnDefinitions>
            <TextBlock Text="#" HorizontalAlignment="Center"
                    Style="{StaticResource Header}"/>
            <TextBlock Grid.Column="2" Text="Title &amp; Artist" HorizontalAlignment="Left"
                    Style="{StaticResource Header}"/>
            <TextBlock Grid.Column="3" Text="Length" HorizontalAlignment="Right"
                    Style="{StaticResource Header}"/>
        </Grid>

        <!--Songs-->
        <DataGrid x:Name="AlbumSongsGrid" LoadingRow="SongsGrid_LoadingRow" Grid.Row="3" Margin="2,4,2,0"
                ItemsSource="{Binding Songs}"
                Style="{StaticResource SongsGrid}"
                RowStyle="{StaticResource SongGridRow}"
                CellStyle="{StaticResource SongGridCell}"
                Tag="{Binding Commands, RelativeSource={RelativeSource AncestorType={x:Type local:AlbumDetailsView}}}"
                PreviewMouseLeftButtonDown="AlbumSongsGrid_LeftMouseDown"
                PreviewMouseRightButtonDown="AlbumSongsGrid_RightMouseDown"
                ContextMenuOpening="AlbumSongsGrid_ContextMenuOpening"
                PreviewMouseMove="AlbumSongsGrid_PreviewMouseMove"
                PreviewDragLeave="SongsGrid_DragLeave"
                PreviewDragOver="AlbumSongsGrid_DragOver"
                PreviewDrop="AlbumSongsGrid_Drop"
                CanUserSortColumns="False" AllowDrop="True">
            <DataGrid.ContextMenu>
                <ContextMenu Style="{StaticResource RoundedContextMenu}"
                             DataContext="{Binding PlacementTarget, RelativeSource={RelativeSource Self}}">
                    <MenuItem Header="Play" Command="{Binding Tag.PlaySongCommand}" CommandParameter="{Binding}">
                        <MenuItem.Icon>
                            <Image Source="/Assets/Icons/Play_32x.png"/>
                        </MenuItem.Icon>
                    </MenuItem>
                    <MenuItem Header="Play Next" Command="{Binding Tag.PlaySongNextCommand}" CommandParameter="{Binding}">
                        <MenuItem.Icon>
                            <Image Source="/Assets/Icons/QueueNext_32x.png"/>
                        </MenuItem.Icon>
                    </MenuItem>
                    <MenuItem Header="Add to Queue" Command="{Binding Tag.AddSongToQueueCommand}" CommandParameter="{Binding}">
                        <MenuItem.Icon>
                            <Image Source="/Assets/Icons/QueueAdd_32x.png"/>
                        </MenuItem.Icon>
                    </MenuItem>
                    <Separator Style="{StaticResource RoundedSeparator}"/>
                    <MenuItem Header="Edit Info" Command="{Binding Tag.EditSongCommand}" CommandParameter="{Binding}">
                        <MenuItem.Icon>
                            <Image Source="/Assets/Icons/Edit_32x.png"/>
                        </MenuItem.Icon>
                    </MenuItem>
                    <Separator Style="{StaticResource RoundedSeparator}"/>
                    <MenuItem Header="Move to another Album" Command="{Binding Tag.MoveSongToAlbumCommand}" CommandParameter="{Binding}">
                        <MenuItem.Icon>
                            <Image Source="/Assets/Icons/MoveToAlbum_32x.png"/>
                        </MenuItem.Icon>
                    </MenuItem>
                    <MenuItem Header="Add to Mix" Command="{Binding Tag.AddSongsToMixCommand}" CommandParameter="{Binding}">
                        <MenuItem.Icon>
                            <Image Source="/Assets/Icons/MixAdd_32x.png"/>
                        </MenuItem.Icon>
                    </MenuItem>
                </ContextMenu>
            </DataGrid.ContextMenu>

            <DataGrid.Columns>
                <DataGridTemplateColumn Width="26">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <TextBlock VerticalAlignment="Center" HorizontalAlignment="Center"
                                       Foreground="{DynamicResource TextBrush}" Opacity="0.5" FontSize="12" Text="{Binding Header, RelativeSource={RelativeSource AncestorType={x:Type DataGridRow}}}"/>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>

                <DataGridTemplateColumn Width="*">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <Grid Margin="2,4">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="44"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>

                                <Border Width="40" Height="40" CornerRadius="3" ClipToBounds="True"
                                        art:CoverArt.Small="True" art:CoverArt.Reference="{Binding Cover}" art:CoverArt.Enabled="True"/>

                                <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="10,0,0,0">
                                    <TextBlock Text="{Binding Title}" FontSize="13" FontWeight="SemiBold"
                                               Foreground="{DynamicResource TextBrush}" TextTrimming="CharacterEllipsis"
                                               ToolTip="{Binding Title}"/>
                                    <TextBlock Text="{Binding Artist}" FontSize="11" Opacity="0.5"
                                               Foreground="{DynamicResource TextBrush}" TextTrimming="CharacterEllipsis"
                                               ToolTip="{Binding Artist}"/>
                                </StackPanel>
                            </Grid>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>

                <DataGridTemplateColumn Width="100">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <TextBlock Text="{Binding Duration, StringFormat={}{0:m\\:ss}}"
                               VerticalAlignment="Center" HorizontalAlignment="Right"
                               Margin="0,0,12,0" Foreground="{DynamicResource TextBrush}"
                               Opacity="0.5"/>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>

                <DataGridTemplateColumn Width="26">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <Border Background="Transparent" ToolTip="Drag to reorder"
                                    Padding="6" Cursor="SizeNS"
                                    PreviewMouseLeftButtonDown="ReorderHandle_MouseDown">
                                <Image Source="/Assets/Icons/Reorder_32x.png" Opacity="0.5"/>
                            </Border>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
            </DataGrid.Columns>
        </DataGrid>
    </Grid>
</UserControl>
