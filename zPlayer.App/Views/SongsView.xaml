<UserControl x:Class="zPlayer.App.Views.SongsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:art="clr-namespace:zPlayer.App.Artwork"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:zPlayer.App.Views"
             xmlns:converters="clr-namespace:zPlayer.App.Converters"
             mc:Ignorable="d" 
             d:DesignHeight="620" d:DesignWidth="1030">
    <UserControl.Resources>
        <Style TargetType="TextBlock" x:Key="SongTitle">
            <Setter Property="Foreground" Value="{DynamicResource TextBrush}"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="TextTrimming" Value="CharacterEllipsis"/>
            <Setter Property="ToolTip" Value="{Binding Title}"/>
        </Style>
        <Style TargetType="TextBlock" x:Key="SongArtist">
            <Setter Property="Foreground" Value="{DynamicResource TextBrush}"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="Opacity" Value="0.5"/>
            <Setter Property="ToolTip" Value="{Binding Artist}"/>
        </Style>
    </UserControl.Resources>
    
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="24"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!--View Header-->
        <Border Grid.Row="0" Style="{StaticResource PanelTop}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                    <TextBlock Text="Songs" Style="{StaticResource WindowTitle}"/>
                    <TextBlock x:Name="SongsInLibraryText" Text="— 000 in library"
                            Style="{StaticResource WindowTitle}" FontWeight="Normal" Opacity="0.5"/>
                </StackPanel>

                <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Right">
                    <TextBox x:Name="SongSearchBox" TextChanged="SongSearchBox_TextChanged"
                            Style="{StaticResource SearchBox}" Tag="Search Songs..." FontSize="12" MinWidth="160"/>
                    
                    <ComboBox Name="SortTypeBox" SelectionChanged="SortBox_SelectionChanged"
                              SelectedIndex="0" Style="{StaticResource HeaderComboBox}"
                              MinWidth="75" Margin="0,0,12,0">
                        <ComboBoxItem Content="Title"/>
                        <ComboBoxItem Content="Artist"/>
                        <ComboBoxItem Content="Album"/>
                        <ComboBoxItem Content="Length"/> <!--Change SortOrderBox to "High-Low" and "Low-High" if this is selected-->
                    </ComboBox>
                    <ComboBox x:Name="SortOrderBox" SelectionChanged="SortBox_SelectionChanged"
                              SelectedIndex="0" Style="{StaticResource HeaderComboBox}" MinWidth="75">
                        <ComboBoxItem Content="A-Z"/>
                        <ComboBoxItem Content="Z-A"/>
                    </ComboBox>
                </StackPanel>
            </Grid>
        </Border>
        
        <Grid Grid.Row="1">
            <Grid.RowDefinitions>
                <RowDefinition Height="56"/>
                <RowDefinition Height="24"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!--Import songs-->
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="2*"/>
                    <ColumnDefinition Width="2*"/>
                </Grid.ColumnDefinitions>
                <Button Click="ImportFolder_Click" Style="{StaticResource ListRowButton}" Grid.Column="1">
                    <Grid Margin="2,4">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="44"/>
                        </Grid.ColumnDefinitions>

                        <Image Grid.Column="1" Source="/Assets/Icons/ImportFolder.png" Width="40" Height="40" Stretch="UniformToFill"/>

                        <StackPanel VerticalAlignment="Center" Margin="0,0,10,0">
                            <TextBlock Text="Import Folder" HorizontalAlignment="Right"
                                       Foreground="{DynamicResource TextBrush}" FontSize="13" FontWeight="SemiBold"/>
                            <TextBlock Text="Add a folder of songs to your library" HorizontalAlignment="Right"
                                       Foreground="{DynamicResource TextBrush}" FontSize="11" Opacity="0.5"/>
                        </StackPanel>
                    </Grid>
                </Button>
                
                <Button Click="ImportSongs_Click" Style="{StaticResource ListRowButton}">
                    <Grid Margin="2,4">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="44"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <Image Source="/Assets/Icons/Import.png" Width="40" Height="40" Stretch="UniformToFill"/>

                        <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="10,0,0,0">
                            <TextBlock Text="Import Songs" Foreground="{DynamicResource TextBrush}"
                               FontSize="13" FontWeight="SemiBold"/>
                            <TextBlock Text="Add individual song files to your library" Foreground="{DynamicResource TextBrush}"
                               FontSize="11" Opacity="0.5"/>
                        </StackPanel>
                    </Grid>
                </Button>
            </Grid>

            <!--Data column headers-->
            <Grid Grid.Row="1" Margin="2,0,24,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="54"/>
                    <ColumnDefinition Width="*" MinWidth="200"/>
                    <ColumnDefinition Width="*" MinWidth="128"/>
                    <ColumnDefinition Width="150"/>
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="1" Text="Title &amp; Artist" HorizontalAlignment="Left"
                           Style="{StaticResource Header}"/>
                <TextBlock Grid.Column="2" Text="Album" HorizontalAlignment="Left"
                           Style="{StaticResource Header}"/>
                <TextBlock Grid.Column="3" Text="Length" HorizontalAlignment="Right"
                           Style="{StaticResource Header}"/>
            </Grid>
            
            <!--Songs data grid-->
            <DataGrid x:Name="SongsGrid" Grid.Row="2" ItemsSource="{Binding Songs}"
                      Tag="{Binding Commands, RelativeSource={RelativeSource AncestorType={x:Type local:SongsView}}}"
                      PreviewMouseLeftButtonDown="SongsGrid_LeftMouseDown"
                      PreviewMouseRightButtonDown="SongsGrid_RightMouseDown"
                      ContextMenuOpening="SongsGrid_ContextMenuOpening"
                      Style="{StaticResource SongsGrid}"
                      RowStyle="{StaticResource SongGridRow}"
                      CellStyle="{StaticResource SongGridCell}">
                <DataGrid.ContextMenu>
                    <ContextMenu Style="{StaticResource RoundedContextMenu}"
                                 DataContext="{Binding PlacementTarget, RelativeSource={RelativeSource Self}}">
                        <MenuItem Header="Play" Command="{Binding Tag.PlaySongCommand}" CommandParameter="{Binding}">
                            <MenuItem.Icon>
                                <Image Source="/Assets/Icons/Play_32x.png"/>
                            </MenuItem.Icon>
                        </MenuItem>
                        <MenuItem Header="Play Next" Command="{Binding Tag.PlaySongNextCommand}" CommandParameter="{Binding}">
                            <MenuItem.Icon>
                                <Image Source="/Assets/Icons/QueueNext_32x.png"/>
                            </MenuItem.Icon>
                        </MenuItem>
                        <MenuItem Header="Add to Queue" Command="{Binding Tag.AddSongToQueueCommand}" CommandParameter="{Binding}">
                            <MenuItem.Icon>
                                <Image Source="/Assets/Icons/QueueAdd_32x.png"/>
                            </MenuItem.Icon>
                        </MenuItem>
                        <Separator Style="{StaticResource RoundedSeparator}"/>
                        <MenuItem Header="Edit Info" Command="{Binding Tag.EditSongCommand}" CommandParameter="{Binding}">
                            <MenuItem.Icon>
                                <Image Source="/Assets/Icons/Edit_32x.png"/>
                            </MenuItem.Icon>
                        </MenuItem>
                        <MenuItem Header="Delete" Command="{Binding Tag.DeleteSongCommand}" CommandParameter="{Binding}">
                            <MenuItem.Icon>
                                <Image Source="/Assets/Icons/Remove_32x.png"/>
                            </MenuItem.Icon>
                        </MenuItem>
                        <Separator Style="{StaticResource RoundedSeparator}"/>
                        <MenuItem Header="Move to Album" Command="{Binding Tag.MoveSongToAlbumCommand}" CommandParameter="{Binding}">
                            <MenuItem.Icon>
                                <Image Source="/Assets/Icons/MoveToAlbum_32x.png"/>
                            </MenuItem.Icon>
                        </MenuItem>
                        <MenuItem Header="Add to Mix" Command="{Binding Tag.AddSongsToMixCommand}" CommandParameter="{Binding}">
                            <MenuItem.Icon>
                                <Image Source="/Assets/Icons/MixAdd_32x.png"/>
                            </MenuItem.Icon>
                        </MenuItem>
                    </ContextMenu>
                </DataGrid.ContextMenu>
                
                <DataGrid.Columns>
                    <DataGridTemplateColumn Width="*" MinWidth="200">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <Grid Margin="2,4">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="44"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>

                                    <Border Width="40" Height="40" CornerRadius="3" art:CoverArt.Small="True" art:CoverArt.Reference="{Binding Cover}" art:CoverArt.Enabled="True">
                                    </Border>

                                    <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="10,0,0,0">
                                        <TextBlock Text="{Binding Title}" Style="{StaticResource SongTitle}"/>
                                        <TextBlock Text="{Binding Artist}" Style="{StaticResource SongArtist}"/>
                                    </StackPanel>
                                </Grid>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>

                    <DataGridTemplateColumn Width="*" MinWidth="120">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding AlbumTitle}" VerticalAlignment="Center" Margin="8,0"
                               Foreground="{DynamicResource TextBrush}" Opacity="0.7" TextTrimming="CharacterEllipsis"/>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>

                    <DataGridTemplateColumn Width="150">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding Duration, StringFormat={}{0:m\\:ss}}"
                                       HorizontalAlignment="Right" VerticalAlignment="Center"
                                       Margin="0,0,12,0" Foreground="{DynamicResource TextBrush}" Opacity="0.7"/>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                </DataGrid.Columns>
            </DataGrid>
        </Grid>
    </Grid>
</UserControl>
